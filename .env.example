# ─────────────────────────────────────────────────────────────
# Copia este archivo como apps/web/.env.local y rellena los valores.
# Los encuentras en tu proyecto de Supabase → Settings → API
# ─────────────────────────────────────────────────────────────

# URL del proyecto. Ej: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave "anon" / publishable. Es pública por diseño: va al navegador y
# está limitada por las políticas RLS de la base de datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL base de la app, usada en los enlaces mágicos de correo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ⚠️ NUNCA pongas aquí la clave service_role.
# Esa clave salta todas las políticas RLS y jamás debe llegar al navegador
# ni quedar en el repositorio. Si algún día hace falta, va como variable
# de entorno del servidor en Vercel, no en este archivo.
